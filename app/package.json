{
  "name": "ra-companion",
  "version": "0.6.4",
  "private": true,
  "description": "RetroAchievements companion with live read-only Dolphin shared-memory context",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "test:regressions": "vitest run --environment jsdom"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^38.1.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "wait-on": "^8.0.4",
    "electron-builder": "^26.0.12",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.dutchdemon.racompanion",
    "productName": "RA Companion",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "tools/**/*",
      "RAM_DIAGNOSTICS.bat",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "RA Companion",
      "icon": "electron/ra-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "RA Companion",
      "deleteAppDataOnUninstall": false,
      "artifactName": "RA Companion Setup ${version}.${ext}",
      "allowElevation": true,
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "selectPerMachineByDefault": true,
      "packElevateHelper": true,
      "installerIcon": "electron/ra-icon.ico",
      "uninstallerIcon": "electron/ra-icon.ico",
      "installerHeaderIcon": "electron/ra-icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DutchDemon",
        "repo": "ra-companion",
        "releaseType": "release"
      }
    ]
  }
}
